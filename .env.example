# ---- LLM provider ----
# gemini (default) | anthropic
LLM_PROVIDER=gemini

# API key for the selected provider (never commit real keys). GEMINI_API_KEY / VITE_GEMINI_API_KEY are also honoured.
LLM_API_KEY=

# Model. Defaults: gemini -> gemini-3.8-flash, anthropic -> claude-sonnet-4-6. For the Pro tier: LLM_MODEL=gemini-3.1-pro
# LLM_MODEL=
